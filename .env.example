# Copy to .env. Do not put real secrets in this file.
# Application records are stored in data/store.json. DATABASE_URL is unused.
# DATABASE_URL=postgresql://gic:change-me@127.0.0.1:5433/gic
AUTH_SECRET=replace-with-openssl-rand-base64-32
# Public origin used in invitation and reset links. Leave unset during local development
# so the session stays on the host you opened (localhost and 127.0.0.1 are different sites).
# AUTH_URL=http://localhost:3000

# Optional institutional identity provider. Login is limited to pre-provisioned accounts.
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=

# Optional email. If SMTP_HOST is empty, messages are stored in the outbox and are not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Protects POST /api/cron/reminders. Leave empty to keep the job disabled.
CRON_SECRET=

# Required only if you intentionally load demonstration data in production.
ALLOW_DEMO_SEED=false

UPLOAD_DIR=storage/uploads
